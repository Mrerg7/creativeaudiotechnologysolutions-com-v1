---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'Creative Audio Technology Solutions | AI-Powered Audio Creation',
  description = 'Explore how AI has unified audio creation, production, and distribution. From ByteDance Seed Audio to real-time AI mixing agents — the future of professional-grade sound is software-driven. Domain available for acquisition.',
  ogImage = 'https://creativeaudiotechnologysolutions.com/og-image.png',
  canonical = 'https://creativeaudiotechnologysolutions.com/',
} = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://creativeaudiotechnologysolutions.com/#website',
      url: 'https://creativeaudiotechnologysolutions.com/',
      name: 'Creative Audio Technology Solutions',
      description,
      publisher: {
        '@id': 'https://creativeaudiotechnologysolutions.com/#organization',
      },
      inLanguage: 'en-US',
    },
    {
      '@type': 'Organization',
      '@id': 'https://creativeaudiotechnologysolutions.com/#organization',
      name: 'Creative Audio Technology Solutions',
      url: 'https://creativeaudiotechnologysolutions.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://creativeaudiotechnologysolutions.com/favicon.svg',
      },
      sameAs: [],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://creativeaudiotechnologysolutions.com/#webpage',
      url: 'https://creativeaudiotechnologysolutions.com/',
      name: title,
      isPartOf: {
        '@id': 'https://creativeaudiotechnologysolutions.com/#website',
      },
      about: {
        '@type': 'Thing',
        name: 'AI Audio Technology',
      },
      description,
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Creative Audio Technology Solutions" />
    <meta name="theme-color" content="#0a0a0f" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Creative Audio Technology Solutions" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen bg-surface-900 text-slate-100">
    <slot />
  </body>
</html>
