---
import { site } from '../data/site';

interface Props {
  id?: string;
  heading?: string;
  lede?: string;
}

const {
  id = 'inquire',
  heading = 'Tell the seller how you would use it',
  lede = `The form opens your email app with a finished message to ${site.email}. Nothing is stored on this website.`,
} = Astro.props;
---

<section id={id} class="scroll-mt-24">
  <div class="overflow-hidden rounded-2xl border border-white/10 bg-surface-800/80">
    <div class="grid lg:grid-cols-[0.85fr_1.15fr]">
      <div class="border-b border-white/10 bg-surface-900/80 px-6 py-8 sm:px-8 sm:py-10 lg:border-b-0 lg:border-r">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-neon-cyan">Confidential inquiry</p>
        <h2 class="mt-3 font-display text-3xl tracking-tight text-white sm:text-4xl">{heading}</h2>
        <p class="mt-4 text-sm leading-relaxed text-slate-400 sm:text-base">{lede}</p>
        <dl class="mt-8 space-y-4 text-sm">
          <div>
            <dt class="text-slate-500">Email</dt>
            <dd class="mt-1">
              <a
                class="font-semibold text-white underline decoration-white/30 underline-offset-4 hover:text-neon-cyan"
                href={`mailto:${site.email}?subject=${encodeURIComponent(`Inquiry: ${site.domain} Domain Acquisition`)}`}
              >
                {site.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-slate-500">Subject line that works</dt>
            <dd class="mt-1 text-slate-300">Inquiry: {site.domain}</dd>
          </div>
          <div>
            <dt class="text-slate-500">Useful to include</dt>
            <dd class="mt-1 text-slate-300">Who you are, the intended use, and a budget if you have one.</dd>
          </div>
        </dl>
      </div>

      <form data-inquire class="px-6 py-8 sm:px-8 sm:py-10" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium text-slate-200">
            Name
            <input
              required
              name="name"
              autocomplete="name"
              class="mt-1.5 w-full min-h-12 rounded-xl border border-white/10 bg-surface-900 px-3 text-base text-white outline-none focus:border-neon-cyan"
            />
          </label>
          <label class="block text-sm font-medium text-slate-200">
            Email
            <input
              required
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              class="mt-1.5 w-full min-h-12 rounded-xl border border-white/10 bg-surface-900 px-3 text-base text-white outline-none focus:border-neon-cyan"
            />
          </label>
          <label class="block text-sm font-medium text-slate-200 sm:col-span-2">
            Company or project <span class="font-normal text-slate-500">(optional)</span>
            <input
              name="company"
              autocomplete="organization"
              class="mt-1.5 w-full min-h-12 rounded-xl border border-white/10 bg-surface-900 px-3 text-base text-white outline-none focus:border-neon-cyan"
            />
          </label>
          <label class="block text-sm font-medium text-slate-200 sm:col-span-2">
            Intended use
            <select
              required
              name="use"
              class="mt-1.5 w-full min-h-12 rounded-xl border border-white/10 bg-surface-900 px-3 text-base text-white outline-none focus:border-neon-cyan"
            >
              <option value="">Select one</option>
              <option>AI audio platform or product</option>
              <option>Production studio or agency</option>
              <option>Plugin / tools company</option>
              <option>Research or education brand</option>
              <option>Media or newsletter</option>
              <option>Defensive brand hold</option>
              <option>Domain broker, for a named principal</option>
              <option>Something else</option>
            </select>
          </label>
          <label class="block text-sm font-medium text-slate-200 sm:col-span-2">
            Offer or budget <span class="font-normal text-slate-500">(optional)</span>
            <input
              name="budget"
              placeholder="A range is fine"
              class="mt-1.5 w-full min-h-12 rounded-xl border border-white/10 bg-surface-900 px-3 text-base text-white outline-none placeholder:text-slate-600 focus:border-neon-cyan"
            />
          </label>
          <label class="block text-sm font-medium text-slate-200 sm:col-span-2">
            Message <span class="font-normal text-slate-500">(optional)</span>
            <textarea
              name="message"
              rows="4"
              class="mt-1.5 w-full rounded-xl border border-white/10 bg-surface-900 px-3 py-3 text-base text-white outline-none focus:border-neon-cyan"
            ></textarea>
          </label>
        </div>

        <button type="submit" class="btn-primary mt-5 w-full sm:w-auto">
          Open email to send
        </button>
        <p data-inquire-status class="mt-3 text-sm leading-relaxed text-slate-500" role="status"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const email = 'sales@desertrich.com';
  const domain = 'creativeaudiotechnologysolutions.com';

  document.querySelectorAll('form[data-inquire]').forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const from = String(data.get('email') || '').trim();
      const company = String(data.get('company') || '').trim();
      const use = String(data.get('use') || '').trim();
      const budget = String(data.get('budget') || '').trim();
      const message = String(data.get('message') || '').trim();

      const subject = `Inquiry: ${domain} — ${name}`;
      const body = [
        `Domain: ${domain}`,
        `Name: ${name}`,
        `Email: ${from}`,
        `Organization: ${company || '—'}`,
        `Intended use: ${use}`,
        `Offer or budget: ${budget || '—'}`,
        '',
        message || '(no additional message)',
      ].join('\n');

      const status = form.querySelector('[data-inquire-status]');
      if (status) {
        status.textContent = `Opening your email app. If nothing opens, write ${email} directly.`;
      }

      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
