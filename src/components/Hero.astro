---
import { site } from '../data/site';
---

<section class="relative overflow-hidden min-h-[min(100svh,880px)] flex items-center pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
    <img
      src={site.heroImage}
      alt=""
      class="absolute inset-0 h-full w-full max-w-none object-cover"
      width="1024"
      height="558"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-surface-900/80 via-surface-900/70 to-surface-900"
    ></div>
  </div>
  <div class="absolute inset-0 bg-grid-pattern bg-[size:40px_40px] opacity-30 pointer-events-none" aria-hidden="true"></div>

  <div class="container-narrow relative z-10">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-display text-2xl sm:text-3xl md:text-4xl text-white tracking-tight mb-4">
        Creative Audio Technology Solutions
      </p>
      <p class="text-sm sm:text-base text-neon-cyan font-medium mb-8 break-all">
        {site.domain} — for sale
      </p>

      <h1 class="heading-display mb-6">
        The .com for AI-native
        <span class="gradient-text"> audio brands</span>
      </h1>

      <p class="mx-auto max-w-2xl text-lg sm:text-xl text-slate-300 leading-relaxed mb-10">
        A category-clear domain for platforms, studios, and tools shaping generative sound, production agents, and immersive listening.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/acquire/#inquire" class="btn-primary w-full sm:w-auto">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Make a confidential offer
        </a>
        <a href="#shift" class="btn-secondary w-full sm:w-auto">
          Explore the category
        </a>
      </div>
    </div>
  </div>
</section>
