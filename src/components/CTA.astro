---
import Inquire from './Inquire.astro';
import { site } from '../data/site';
---

<section id="acquire" class="section-padding relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-neon-cyan/5 via-transparent to-neon-purple/5 pointer-events-none" aria-hidden="true"></div>
  <div class="container-narrow relative">
    <div class="mx-auto max-w-3xl text-center mb-12">
      <p class="text-sm font-semibold uppercase tracking-wider text-neon-cyan mb-4">Domain acquisition</p>
      <h2 class="heading-section mb-6">
        Secure <span class="gradient-text break-all">{site.domain}</span>
      </h2>
      <p class="text-lg text-slate-300 leading-relaxed">
        This premium domain positions a brand, platform, or consultancy in the AI-audio category.
        Clear name. Direct inquiry. Escrow welcome.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <Inquire
        heading="Start the acquisition conversation"
        lede={`Serious inquiries only. Response typically within 1–2 business days at ${site.email}.`}
      />
    </div>
  </div>
</section>
