---
import { mailto, site } from '../data/site';
---

<footer class="border-t border-white/5 bg-surface-900">
  <div class="border-b border-white/5 bg-surface-800/60">
    <div class="container-narrow py-10 sm:py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
        <div class="max-w-xl">
          <p class="text-xs font-semibold uppercase tracking-widest text-neon-cyan mb-2">
            Premium domain available
          </p>
          <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 break-all">
            {site.domain}
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            A category-defining name for AI-native audio platforms, tools, and services.
            Position your brand at the intersection of creativity and computational audio.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/acquire/#inquire" class="btn-primary !text-sm !px-5 !py-3">
            Make an offer
          </a>
          <a href={mailto} class="btn-secondary !text-sm !px-5 !py-3">
            {site.email}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container-narrow py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 mb-12">
      <div class="sm:col-span-2">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-neon-cyan/10 ring-1 ring-neon-cyan/30">
            <svg class="h-4 w-4 text-neon-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 18V5l12-2v13" />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="16" r="3" />
            </svg>
          </div>
          <span class="font-semibold text-white">{site.name}</span>
        </div>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          Demonstration site for a premium domain covering AI audio creation, production, and listening.
          Not an operating studio or SaaS product.
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Explore</p>
        <ul class="space-y-1 text-sm">
          <li><a href="/insights/" class="inline-flex min-h-11 items-center text-slate-400 hover:text-white transition">Insights</a></li>
          <li><a href="/faq/" class="inline-flex min-h-11 items-center text-slate-400 hover:text-white transition">FAQ</a></li>
          <li><a href="/acquire/" class="inline-flex min-h-11 items-center text-slate-400 hover:text-white transition">Acquire</a></li>
          <li><a href="/#shift" class="inline-flex min-h-11 items-center text-slate-400 hover:text-white transition">The Shift</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Acquisition</p>
        <ul class="space-y-1 text-sm">
          <li>
            <a href={mailto} class="inline-flex min-h-11 items-center text-slate-400 hover:text-neon-cyan transition">
              {site.email}
            </a>
          </li>
          <li class="text-slate-500 text-xs pt-1">Serious offers only · Escrow welcome</li>
        </ul>
      </div>
    </div>

    <div class="rounded-xl border border-white/5 bg-surface-800/40 p-5 mb-10">
      <p class="text-xs text-slate-500 leading-relaxed">
        <strong class="text-slate-400">Disclaimer:</strong>
        This website is for demonstration and informational purposes only. It does not constitute an offer of services,
        a commitment to deploy, or a guarantee of search rankings or outcomes. Statistics and technology references
        are based on publicly discussed industry trends and may change. Domain inquiries go exclusively to
        <a href={mailto} class="text-neon-cyan hover:underline">{site.email}</a>.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-white/5">
      <p class="text-xs text-slate-500">
        © {new Date().getFullYear()} {site.domain} — All rights reserved.
      </p>
      <p class="text-xs text-slate-600">
        Built with Astro · Cloudflare Workers
      </p>
    </div>
  </div>
</footer>
