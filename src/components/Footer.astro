---
---
<footer class="border-t border-white/5 bg-surface-900">
  <!-- Sophisticated domain CTA strip -->
  <div class="border-b border-white/5 bg-gradient-to-r from-surface-800 via-surface-800/80 to-surface-800">
    <div class="container-narrow py-10 sm:py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
        <div class="max-w-xl">
          <p class="text-xs font-semibold uppercase tracking-widest text-neon-cyan mb-2">
            Premium Domain Available
          </p>
          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
            creativeaudiotechnologysolutions.com
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            A category-defining name for the next wave of AI-native audio platforms, tools, and services.
            Position your brand at the intersection of creativity and computational audio.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="mailto:sales@desertrich.com?subject=Domain%20Inquiry%20-%20creativeaudiotechnologysolutions.com"
            class="btn-primary !text-sm !px-5 !py-3"
          >
            Contact sales@desertrich.com
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="container-narrow py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 mb-12">
      <div class="sm:col-span-2">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-neon-cyan/10 ring-1 ring-neon-cyan/30">
            <svg class="h-4 w-4 text-neon-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13" />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="16" r="3" />
            </svg>
          </div>
          <span class="font-semibold text-white">Creative Audio Technology Solutions</span>
        </div>
        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          Informational demonstration site exploring the transformation of audio creation,
          production, and listening through modern AI systems.
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Explore</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#shift" class="text-slate-400 hover:text-white transition">The Shift</a></li>
          <li><a href="#generation" class="text-slate-400 hover:text-white transition">Content Generation</a></li>
          <li><a href="#production" class="text-slate-400 hover:text-white transition">Production & Post</a></li>
          <li><a href="#listening" class="text-slate-400 hover:text-white transition">Listening & Distribution</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-4">Acquisition</p>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="mailto:sales@desertrich.com" class="text-slate-400 hover:text-neon-cyan transition">
              sales@desertrich.com
            </a>
          </li>
          <li class="text-slate-500 text-xs pt-1">Serious offers only</li>
        </ul>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="rounded-xl border border-white/5 bg-surface-800/40 p-5 mb-10">
      <p class="text-xs text-slate-500 leading-relaxed">
        <strong class="text-slate-400">Disclaimer:</strong>
        This website is for demonstration and informational purposes only. It does not constitute an offer of services,
        a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific
        technologies are based on publicly available information as of the date shown and are subject to change.
        Domain inquiries should be directed exclusively to <a href="mailto:sales@desertrich.com" class="text-neon-cyan hover:underline">sales@desertrich.com</a>.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-white/5">
      <p class="text-xs text-slate-500">
        © {new Date().getFullYear()} creativeaudiotechnologysolutions.com — All rights reserved.
      </p>
      <p class="text-xs text-slate-600">
        Built with Astro · Deployed on Cloudflare Workers Static Assets
      </p>
    </div>
  </div>
</footer>
