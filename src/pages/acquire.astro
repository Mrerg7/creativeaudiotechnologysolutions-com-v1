---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Inquire from '../components/Inquire.astro';
import { uses, site } from '../data/site';
import { breadcrumbLd, productLd } from '../data/seo';

const title = `Buy ${site.domain} | Domain Acquisition`;
const description = `Acquire ${site.domain}. See who the name fits, what a transfer includes, and send a confidential offer to ${site.email}.`;
const canonical = `${site.url}/acquire/`;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  modified={site.updated}
  jsonLd={[
    breadcrumbLd([
      { name: 'Home', url: `${site.url}/` },
      { name: 'Acquire', url: canonical },
    ]),
    productLd(),
  ]}
>
  <Header />
  <main id="main">
    <section class="border-b border-white/5 pt-28 pb-12 sm:pt-32 sm:pb-16">
      <div class="container-narrow max-w-3xl">
        <Breadcrumbs items={[{ href: '/', label: 'Home' }, { label: 'Acquire' }]} />
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-neon-cyan">Domain acquisition</p>
        <h1 class="mt-3 heading-section break-all">Buy {site.domain}</h1>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">
          You are acquiring a .com. Not a social following, not a revenue stream, and not an operating audio company.
          If that is the asset you want, the path below is the whole path.
        </p>
      </div>
    </section>

    <article class="container-narrow max-w-3xl py-12 sm:py-16">
      <h2 id="uses" class="text-2xl font-bold text-white scroll-mt-24">Who should buy it</h2>
      <p class="mt-4 text-slate-300 leading-relaxed">
        The name works when the buyer will use the full phrase in public: on a product, studio site, tools brand, or media property.
        It is a long descriptive .com — strongest as a category flag, weaker as a short consumer app nickname.
      </p>

      <div class="mt-8 grid gap-4">
        {
          uses.map((item) => (
            <section id={item.id} class="scroll-mt-24 rounded-2xl border border-white/10 bg-surface-800/50 p-5 sm:p-6">
              <h3 class="text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-slate-400">{item.text}</p>
            </section>
          ))
        }
      </div>

      <div class="prose-sale mt-12">
        <h2 id="included" class="text-2xl font-bold text-white scroll-mt-24">What is included</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-300">
          <li>The registered domain <strong class="text-white">{site.domain}</strong>.</li>
          <li>A standard registrar transfer by authorization code.</li>
          <li>Escrow if you want a neutral party holding funds until the name moves.</li>
        </ul>
        <h3 class="mt-8 text-xl font-semibold text-white">What is not included</h3>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-300">
          <li>Customers, email lists, revenue, or social accounts.</li>
          <li>This website’s design, beyond the fact you can replace it the day DNS is yours.</li>
          <li>A trademark, a business name clearance, or any audio-industry license.</li>
          <li>Any promise of search rankings or domain-authority scores. Those are earned after you own it, mostly by other sites linking to you.</li>
        </ul>

        <h2 id="process" class="mt-12 text-2xl font-bold text-white scroll-mt-24">How the transfer works</h2>
        <ol class="mt-4 list-decimal space-y-3 pl-5 text-base leading-relaxed text-slate-300">
          <li>You inquire with identity, intended use, and an offer or a request for the asking price.</li>
          <li>If both sides agree, you sign a short domain purchase agreement.</li>
          <li>You fund escrow. The seller does not release the authorization code against an unsecured wire from a stranger.</li>
          <li>You start the transfer at your registrar. The seller approves it. Most .com moves complete within a few days after release.</li>
        </ol>
      </div>

      <div class="mt-14">
        <Inquire />
      </div>
    </article>
  </main>
  <Footer />
</Layout>
