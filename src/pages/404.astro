---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found | Creative Audio Technology Solutions"
  description="The requested page could not be found."
  noindex={true}
>
  <Header />
  <main class="flex-1 flex items-center justify-center section-padding px-4 min-h-[70svh]">
    <div class="text-center max-w-md mx-auto">
      <p class="text-6xl font-bold text-neon-cyan mb-4">404</p>
      <h1 class="text-2xl sm:text-3xl font-semibold text-white mb-4">Page not found</h1>
      <p class="text-slate-400 mb-8 leading-relaxed">
        The page you’re looking for doesn’t exist or has been moved.
      </p>
      <a href="/" class="btn-primary min-h-12 px-8">Return Home</a>
    </div>
  </main>
  <Footer />
</Layout>
